# ==============================================================================
# cloud-filter 設定ファイル
# Source: https://github.com/rezmoss/cloud-provider-ip-addresses
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DROP対象リストの指定
# ------------------------------------------------------------------------------
# デフォルトは "all_providers"（リポジトリ内の全クラウド・Bot統合CIDRリスト:
# all_providers/all_providers_merged_v4.txt および _v6.txt）を使用します。
# 特定のプロバイダーのみに絞りたい場合のみスペース区切りで指定してください。
PROVIDERS="all_providers"

# 除外したいプロバイダーがある場合のみ指定（通常は空でOK。IP単位の除外は whitelist.txt で設定）
EXCLUDE_PROVIDERS=""

# ------------------------------------------------------------------------------
# 2. IPv4 / IPv6 の有効化設定
# ------------------------------------------------------------------------------
ENABLE_IPV4="true"
ENABLE_IPV6="true"

# ------------------------------------------------------------------------------
# 3. ホワイトリスト (誤遮断防止: 除外IP/CIDR) 設定
# ------------------------------------------------------------------------------
# 遮断したくないIP/CIDRを記載したファイルのパス
WHITELIST_FILE="./whitelist.txt"

# 実行時に現在のSSH接続元IP・自サーバーのインターフェースIP・デフォルトゲートウェイ・
# DNSリゾルバIPを自動的にホワイトリストへ追加してロックアウトを防ぐか
AUTO_WHITELIST_ENV="true"

# ------------------------------------------------------------------------------
# 4. iptables / ip6tables / ipset 設定
# ------------------------------------------------------------------------------
# 専用チェイン名（既存ルールを汚さず、このチェイン内で完結させます）
IPTABLES_CHAIN="CLOUD_FILTER"

# 専用チェインをフックする親チェイン（スペース区切りで複数指定可: 例 "INPUT DOCKER-USER"）
IPTABLES_TARGET_CHAINS="INPUT"

# クラウドIPからでも常に通信を許可する宛先ポート（カンマ区切り、空なら全ポートDROP対象）
# - 外部メールサーバー(Gmail/M365/SES等)からのSMTP配送着信のみ許可する場合: "25"
# - クラウド/VPN経由のメーラーからIMAP/Submissionも使う場合: "25,465,587,143,993"
ALLOW_TCP_PORTS="25"
ALLOW_UDP_PORTS=""

# ipset のセット名
IPSET_DROP_V4="cloud_drop_v4"
IPSET_DROP_V6="cloud_drop_v6"
IPSET_ALLOW_V4="cloud_allow_v4"
IPSET_ALLOW_V6="cloud_allow_v6"

# DROP直前にレート制限付きでカーネルログ(syslog)へ記録するか ("true" / "false")
LOG_DROPS="false"
LOG_PREFIX="[CLOUD-FILTER-DROP] "

# ------------------------------------------------------------------------------
# 5. データ取得元URL・出力先ディレクトリ
# ------------------------------------------------------------------------------
# GitHub Raw をプライマリとし、障害時は jsDelivr CDN へ自動フォールバックします
PRIMARY_BASE_URL="https://raw.githubusercontent.com/rezmoss/cloud-provider-ip-addresses/main"
FALLBACK_BASE_URL="https://cdn.jsdelivr.net/gh/rezmoss/cloud-provider-ip-addresses@main"

# 生成されたCIDRリストおよびipsetリストアファイルの保存先
OUTPUT_DIR="./output"
