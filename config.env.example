# ==============================================================================
# cloud-filter 設定ファイル
# Source: https://github.com/rezmoss/cloud-provider-ip-addresses
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DROP対象プロバイダーの指定 (スペースまたはカンマ区切り)
# ------------------------------------------------------------------------------
# 全プロバイダーを一括でDROPする場合は "all_providers" を指定してください。
# 個別に指定する場合はプロバイダー名を列挙します（`./cloud-filter.sh list-providers` で一覧確認可能）。
#
# 主なプロバイダー例:
#   クラウド: aws azure googlecloud digitalocean oracle linode vultr hetzner ovhcloud contabo scaleway
#   AI/クローラー: gptbot claudebot perplexitybot amazonbot applebot googlebot bingbot duckduckbot commoncrawl
#   匿名化/VPN: tor mullvad apple_private_relay
#   その他BGP等: alibaba tencent huawei baidu yandex akamai
PROVIDERS="gptbot claudebot perplexitybot amazonbot commoncrawl tor"

# ------------------------------------------------------------------------------
# 2. 除外プロバイダー (誤遮断防止用)
# ------------------------------------------------------------------------------
# PROVIDERS="all_providers" 等を指定した際、自社で利用しているCDNやクラウド、
# 許可したい検索エンジンBot等を丸ごとDROP対象から除外したい場合に指定します。
# 例: EXCLUDE_PROVIDERS="cloudflare fastly googlebot bingbot github"
EXCLUDE_PROVIDERS="cloudflare"

# ------------------------------------------------------------------------------
# 3. IPv4 / IPv6 の有効化設定
# ------------------------------------------------------------------------------
ENABLE_IPV4="true"
ENABLE_IPV6="true"

# ------------------------------------------------------------------------------
# 4. ホワイトリスト (誤遮断防止) 設定
# ------------------------------------------------------------------------------
# カスタム除外IP/CIDRを記載したファイルのパス
WHITELIST_FILE="./whitelist.txt"

# 実行時に現在のSSH接続元IPやデフォルトゲートウェイ、ローカルインターフェースIPを
# 自動的にホワイトリストへ追加して締め出し(ロックアウト)を防ぐか
AUTO_WHITELIST_ENV="true"

# ------------------------------------------------------------------------------
# 5. iptables / ip6tables / ipset 設定
# ------------------------------------------------------------------------------
# 専用チェイン名（既存ルールを汚さず、このチェイン内で完結させます）
IPTABLES_CHAIN="CLOUD_FILTER"

# 専用チェインをフックする親チェイン（スペース区切りで複数指定可: 例 "INPUT DOCKER-USER"）
IPTABLES_TARGET_CHAINS="INPUT"

# ipset のセット名
IPSET_DROP_V4="cloud_drop_v4"
IPSET_DROP_V6="cloud_drop_v6"
IPSET_ALLOW_V4="cloud_allow_v4"
IPSET_ALLOW_V6="cloud_allow_v6"

# DROP直前にレート制限付きでカーネルログ(syslog)へ記録するか ("true" / "false")
LOG_DROPS="false"
LOG_PREFIX="[CLOUD-FILTER-DROP] "

# ------------------------------------------------------------------------------
# 6. データ取得元URL・出力先ディレクトリ
# ------------------------------------------------------------------------------
# リポジトリ推奨のjsDelivr CDNをプライマリとし、障害時はGitHub Rawへ自動フォールバックします
PRIMARY_BASE_URL="https://cdn.jsdelivr.net/gh/rezmoss/cloud-provider-ip-addresses@main"
FALLBACK_BASE_URL="https://raw.githubusercontent.com/rezmoss/cloud-provider-ip-addresses/main"

# 生成されたCIDRリストおよびipsetリストアファイルの保存先
OUTPUT_DIR="./output"
